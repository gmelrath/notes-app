// Copy this file to Secrets.xcconfig (same folder) and paste your keys in.
// Secrets.xcconfig is ignored by git, so keys never reach GitHub.

// Notion internal integration secret, from notion.so/profile/integrations.
NOTION_TOKEN = paste-your-notion-secret-here

// Resend API key (Sending access), from resend.com/api-keys.
RESEND_API_KEY = paste-your-resend-key-here
